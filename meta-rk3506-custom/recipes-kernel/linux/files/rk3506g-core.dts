/*
 * I2C1 - Touch Controller (via RS0104 level shifter)
 * 1.8V side: CTP_1V8_SDA/SCL
 * 3.3V side: I2C1_CTP_SDA/SCL
 */
&i2c1 {
	status = "okay";
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io13_i2c1_scl &rm_io12_i2c1_sda>;

	touchscreen@38 {
		compatible = "hyn,cst128a";
		reg = <0x38>;
		/* CTP INT @ GPIO0_B6 (pin 4), Reset @ GPIO2_A4 (pin 57) */
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PB6 IRQ_TYPE_LEVEL_LOW>;
		reset-gpios = <&gpio2 RK_PA4 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};
};

&pinctrl {
	/* Touch interrupt @ GPIO0_B6 */
	touch {
		touch_gpio: touch-gpio {
			rockchip,pins = <0 RK_PB6 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
};

&pinctrl {
	usb {
		usb_extcon_vbus: usb-extcon-vbus {
			rockchip,pins = <1 RK_PC5 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		vcc5v0_otg0_en: vcc5v0-otg0-en {
			rockchip,pins = <1 RK_PC4 RK_FUNC_GPIO &pcfg_pull_none>;
		};

	};

	sdmmc {
		/omit-if-no-ref/
		sdmmc_det: sdmmc-det {
			rockchip,pins = <3 RK_PA7 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
};

&display_subsystem {
	status = "okay";
	/* logo-memory-region = <&drm_logo>; */
};

&vop {
	status = "okay";
};

&route_dsi {
	status = "okay";
};

/*
 * Ethernet - RTL8201F RMII PHY
 * PHY address: 0x0
 * 25MHz clock from external oscillator (X3)
 */
&gmac0 {
	phy-mode = "rmii";
	clock_in_out = "input";

	/* PHY reset: GPIO2_A0 (pin 59) */
	snps,reset-gpio = <&gpio2 RK_PA0 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	snps,reset-delays-us = <0 20000 100000>;

	pinctrl-names = "default";
	pinctrl-0 = <&eth_rmii0_miim_pins
		     &eth_rmii0_tx_bus2_pins
		     &eth_rmii0_rx_bus2_pins
		     &eth_rmii0_clk_pins>;

	phy-handle = <&rtl8201f>;
	status = "okay";
};

&mdio0 {
	status = "okay";

	rtl8201f: phy@0 {
		compatible = "realtek,rtl8201f", "ethernet-phy-ieee802.3-c22";
		reg = <0x0>;
		max-speed = <100>;
		/* External 25MHz crystal (X3) provides PHY clock */
	};
};

/*
 * UART1 - RS485 Channel 1 & 2 (TP75176E x2)
 */
&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io9_uart1_tx &rm_io7_uart1_rx>;
	linux,rs485-enabled-at-boot-time;
	rs485-rts-active-high;
	status = "okay";
};

/*
 * UART2 - RS485 Channel 3 & 4 (TP75176E x2)
 */
&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io6_uart2_tx &rm_io4_uart2_rx>;
	linux,rs485-enabled-at-boot-time;
	rs485-rts-active-high;
	status = "okay";
};

&uart0 {
	/* UART0 must be disabled when FIQ debugger uses it */
	/* FIQ debugger will take control of UART0 */
	status = "disabled";
};

&uart3 {
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io3_uart3_tx &rm_io1_uart3_rx>;
	linux,rs485-enabled-at-boot-time;
	rs485-rts-active-high;
	status = "okay";
};

&uart4 {
	dma-names = "!tx", "!rx";	/* remove ! to enable dma */
	pinctrl-names = "default";
};

/*
 * SPI0 - ADS8664 4-Channel ADC
 */
&spi0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io16_spi0_clk &rm_io15_spi0_csn0 &rm_io17_spi0_mosi &rm_io18_spi0_miso>;

	adc_ads8664: ads8664@0 {
		compatible = "ti,ads8664";
		reg = <0>;
		spi-max-frequency = <10000000>;
		status = "okay";
	};
};

&u2phy_otg0 {
	vbus-supply = <&vcc5v0_otg0>;
	rockchip,gpio-vbus-det;
	status = "okay";
};


&usb2phy {
	extcon = <&extcon_usb>;
	status = "okay";
};

&mmc {
	/* Override MMC configuration for SD card support */
	/* Remove no-sd and non-removable properties from base dtsi */
	/delete-property/ no-sd;
	/delete-property/ non-removable;
	/delete-property/ mmc-pwrseq;
	no-sdio;
	no-mmc;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	/* DEBUG: Temporarily disable CD detection to force card recognition */
	/* cd-gpios = <&gpio3 RK_PA7 GPIO_ACTIVE_LOW>; */
	broken-cd;
	disable-wp;
	sd-uhs-sdr104;
	max-frequency = <150000000>;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc_clk_pins &sdmmc_cmd_pins &sdmmc_bus4_pins>;
	status = "okay";
};


